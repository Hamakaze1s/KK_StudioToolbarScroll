<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>KK_StudioToolbarScroll</AssemblyName>
    <RootNamespace>KK_StudioToolbarScroll</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\$(Configuration)</OutputPath>
    <Nullable>disable</Nullable>
    <!-- Keep the local checkout path out of the embedded debug info -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))=KK_StudioToolbarScroll</PathMap>
    <!-- Game install used for the KKAPI reference and post-build copy: pass -p:GameDir=... or put it in GameDir.props (git-ignored) -->
    <GameDir Condition="'$(GameDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\GameDir.props')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\GameDir.props').Trim())</GameDir>
    <CopyToGame Condition="'$(CopyToGame)' == ''">true</CopyToGame>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.18.0" PrivateAssets="all" />
    <PackageReference Include="IllusionLibs.BepInEx" Version="5.4.22" />
    <PackageReference Include="IllusionLibs.BepInEx.Harmony" Version="2.9.0" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine" Version="5.6.2.4" />
    <PackageReference Include="IllusionLibs.Koikatu.UnityEngine.UI" Version="5.6.2.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolbarManager only exists in KKAPI 1.43+, newer than the NuGet package, so reference the game's copy -->
    <Reference Include="KKAPI">
      <HintPath>$(GameDir)\BepInEx\plugins\KKAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Never copy game/library dlls to output -->
  <Target Name="SkipAllRefs" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

  <Target Name="RequireGameDir" BeforeTargets="ResolveAssemblyReferences;CoreCompile" Condition="'$(GameDir)' == ''">
    <Error Text="GameDir is not set. Pass -p:GameDir=&quot;C:/path/to/Koikatu&quot; or write the path into GameDir.props next to the solution folder." />
  </Target>

  <Target Name="CopyToGamePlugins" AfterTargets="Build" Condition="'$(CopyToGame)' == 'true' And Exists('$(GameDir)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" />
  </Target>
</Project>
